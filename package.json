{
  "name": "@argentic/chest-sdk",
  "version": "0.5.0",
  "description": "The client a Chest server tool embeds: the member the Chest asserts on a request, the Chest itself (its organization, time zone, language and currency, and where the tool is reached), who else has the tool, the tool's own database, its sealed values, its private files, badges and notifications inside the Chest, the events of its members' lifecycle and between tools, the runs of its schedules, AI models through the Chest, live updates of its members' pages (and their browser client), a fake Chest for its tests — and the tool contract, published in its repository (chest check is @argentic/chest-check).",
  "keywords": [
    "chest",
    "argentic",
    "sdk",
    "chest-tool",
    "member",
    "files",
    "database",
    "members",
    "notifications",
    "events",
    "schedules",
    "ai",
    "llm",
    "sealed",
    "realtime"
  ],
  "homepage": "https://github.com/chest-by-argentic/Chest-SDK#readme",
  "bugs": {
    "url": "https://github.com/chest-by-argentic/Chest-SDK/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chest-by-argentic/Chest-SDK.git"
  },
  "license": "MIT",
  "author": "Argentic",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "workspaces": [
    "check"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    },
    "./member": {
      "types": "./dist/src/member.d.ts",
      "default": "./dist/src/member.js"
    },
    "./chest": {
      "types": "./dist/src/chest.d.ts",
      "default": "./dist/src/chest.js"
    },
    "./database": {
      "types": "./dist/src/database.d.ts",
      "default": "./dist/src/database.js"
    },
    "./files": {
      "types": "./dist/src/files.d.ts",
      "default": "./dist/src/files.js"
    },
    "./members": {
      "types": "./dist/src/members.d.ts",
      "default": "./dist/src/members.js"
    },
    "./notifications": {
      "types": "./dist/src/notifications.d.ts",
      "default": "./dist/src/notifications.js"
    },
    "./events": {
      "types": "./dist/src/events.d.ts",
      "default": "./dist/src/events.js"
    },
    "./schedules": {
      "types": "./dist/src/schedules.d.ts",
      "default": "./dist/src/schedules.js"
    },
    "./ai": {
      "types": "./dist/src/ai.d.ts",
      "default": "./dist/src/ai.js"
    },
    "./sealed": {
      "types": "./dist/src/sealed.d.ts",
      "default": "./dist/src/sealed.js"
    },
    "./realtime": {
      "types": "./dist/src/realtime.d.ts",
      "default": "./dist/src/realtime.js"
    },
    "./realtime/client": {
      "types": "./dist/src/realtime-client.d.ts",
      "default": "./dist/src/realtime-client.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client/index.ts",
    "client/src/api.ts",
    "client/src/signed.ts",
    "client/src/errors.ts",
    "client/src/member.ts",
    "client/src/chest.ts",
    "client/src/members.ts",
    "client/src/database.ts",
    "client/src/files.ts",
    "client/src/notifications.ts",
    "client/src/events.ts",
    "client/src/eventrules.ts",
    "client/src/schedules.ts",
    "client/src/ai.ts",
    "client/src/sealed.ts",
    "client/src/realtime.ts",
    "client/src/realtime-client.ts",
    "client/src/testing.ts",
    "client/src/testing-realtime.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['dist', 'build']) require('node:fs').rmSync(d, {recursive: true, force: true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "npm run build && tsc -p tsconfig.json && node scripts/contract.mjs --check && node --test build/client/test/*.test.js && npm test -w check",
    "contract": "node scripts/contract.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
