{
  "name": "@argentic/chest-sdk",
  "version": "0.1.0",
  "description": "The client a Chest tool embeds: the signed member of a request, its own database and files, and the private channel of a worker.",
  "keywords": [
    "chest",
    "argentic",
    "sdk",
    "chest-tool",
    "member",
    "files",
    "database"
  ],
  "homepage": "https://github.com/chest-by-argentic/Chest-SDK#readme",
  "bugs": {
    "url": "https://github.com/chest-by-argentic/Chest-SDK/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chest-by-argentic/Chest-SDK.git"
  },
  "license": "MIT",
  "author": "Argentic",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    },
    "./channel": {
      "types": "./dist/src/channel.d.ts",
      "default": "./dist/src/channel.js"
    },
    "./record": {
      "types": "./dist/src/record.d.ts",
      "default": "./dist/src/record.js"
    },
    "./requests": {
      "types": "./dist/src/requests.d.ts",
      "default": "./dist/src/requests.js"
    },
    "./worker": {
      "types": "./dist/src/worker.d.ts",
      "default": "./dist/src/worker.js"
    },
    "./member": {
      "types": "./dist/src/member.d.ts",
      "default": "./dist/src/member.js"
    },
    "./database": {
      "types": "./dist/src/database.d.ts",
      "default": "./dist/src/database.js"
    },
    "./files": {
      "types": "./dist/src/files.d.ts",
      "default": "./dist/src/files.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client/index.ts",
    "client/src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['dist', 'build']) require('node:fs').rmSync(d, {recursive: true, force: true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "npm run build && tsc -p tsconfig.json && node --test build/client/test/*.test.js",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
